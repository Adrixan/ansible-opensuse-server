# AI Environment Configuration
# Managed by Ansible - do not edit manually

export GITHUB_PERSONAL_ACCESS_TOKEN="{{ ai_workstation_github_token }}"
{% if ai_workstation_anthropic_workspace_id | default('') | length > 0 %}
export ANTHROPIC_WORKSPACE_ID="{{ ai_workstation_anthropic_workspace_id }}"
{% endif %}
{% if ai_workstation_nextcloud_host | default('') | length > 0 %}

# Nextcloud MCP server (app password, not the login password)
export NEXTCLOUD_HOST="{{ ai_workstation_nextcloud_host }}"
export NEXTCLOUD_USERNAME="{{ ai_workstation_nextcloud_username }}"
export NEXTCLOUD_PASSWORD="{{ ai_workstation_nextcloud_password }}"
{% endif %}

# Ensure Claude Code CLI uses native first-party OAuth subscription without custom gateway overrides
unset ANTHROPIC_BASE_URL
unset ANTHROPIC_AUTH_TOKEN
unset ANTHROPIC_API_KEY
unset ANTHROPIC_MODEL
unset ANTHROPIC_DEFAULT_SONNET_MODEL
unset ANTHROPIC_DEFAULT_HAIKU_MODEL
unset ANTHROPIC_DEFAULT_OPUS_MODEL
unset CLAUDE_CODE_SUBAGENT_MODEL
unset CLAUDE_CODE_MAX_CONTEXT_TOKENS
unset CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT

# Remote control aliases
{% if ai_workstation_antigravity_remote_control | default(true) | bool %}
alias agy="agy --remote-control"
{% endif %}
{% if ai_workstation_opencode_remote_control | default(true) | bool %}
alias opencode-remote="opencode attach http://{{ ai_workstation_opencode_server_host }}:{{ ai_workstation_opencode_server_port }}"
alias opencode-web="opencode web --port {{ ai_workstation_opencode_server_port }} --hostname {{ ai_workstation_opencode_server_host }}"
{% endif %}
