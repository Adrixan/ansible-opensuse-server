# {{ ansible_managed }}
# OpenCode 2 supervises its own shared background server (`opencode service`); a unit that runs
# `opencode serve --service` directly races `opencode service restart`. This unit only starts it at login.
[Unit]
Description=OpenCode shared background server
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart={{ ai_workstation_opencode_bin }} service start
ExecStop={{ ai_workstation_opencode_bin }} service stop
TimeoutStartSec=60s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
