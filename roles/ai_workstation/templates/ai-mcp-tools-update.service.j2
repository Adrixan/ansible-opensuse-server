# {{ ansible_managed }}
[Unit]
Description=Upgrade uv-managed MCP server tools
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/uv tool upgrade --all
# Load the upgraded servers (a no-op where the shared MCP service is not running)
ExecStartPost=-/usr/bin/systemctl --user try-restart mcp-shared.service
Nice=10
