# {{ ansible_managed }}
# One `rc code <project>` modernization session after the other (yadm ~/.local/bin/web-modernize;
# project list ~/sync/ai/web-projects.txt; report ~/sync/ai/web-modernize/<date>.md)
[Unit]
Description=Modern Web Guidance modernization of the web projects, one session at a time
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/web-modernize
Nice=5
TimeoutStartSec=20h
