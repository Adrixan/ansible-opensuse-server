# {{ ansible_managed }}
# Local SearXNG for the searxng MCP server: loopback only, JSON API, no limiter or metrics
use_default_settings: true

general:
  instance_name: "searxng-local"
  enable_metrics: false

server:
  base_url: "http://127.0.0.1:{{ ai_workstation_searxng_port }}/"
  secret_key: "{{ ai_workstation_searxng_secret }}"
  limiter: false
  public_instance: false
  image_proxy: false

search:
  safe_search: 0
  formats:
    - html
    - json
