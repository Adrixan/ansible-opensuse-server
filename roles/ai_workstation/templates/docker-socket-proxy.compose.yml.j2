# {{ ansible_managed }}
# Read-only Docker API for the docker MCP server: POST=0 rejects every mutating call
services:
  docker-socket-proxy:
    image: {{ ai_workstation_docker_mcp_proxy_image }}:{{ github_release.tag }}
    container_name: docker-socket-proxy
    restart: unless-stopped
    environment:
      POST: "0"
      CONTAINERS: "1"
      IMAGES: "1"
      INFO: "1"
      NETWORKS: "1"
      VOLUMES: "1"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    ports:
      - "127.0.0.1:{{ ai_workstation_docker_mcp_proxy_port }}:2375"
    # SELinux (Tumbleweed default) denies container_t access to docker.sock; unconfine only this
    # container, the GET-only proxy is the security boundary
    security_opt:
      - no-new-privileges:true
      - label:disable
