# {{ ansible_managed }}
[Unit]
Description=Update OpenCode CLI (native install)
Wants=network-online.target
After=network-online.target
# A laptop's catch-up run right after a wake may come before the network: retry a few times
StartLimitIntervalSec=1h
StartLimitBurst=4

[Service]
Type=oneshot
Restart=on-failure
RestartSec=5min
ExecStart={{ opencode_cli_bin }} upgrade --method curl
# Also catches updates installed in the background by `update: auto`
ExecStartPost={{ opencode_restart_stale_server_script }}
Nice=10
