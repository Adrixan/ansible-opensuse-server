# {{ ansible_managed }}
[Unit]
Description=Update Claude Code CLI (native install)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
UnsetEnvironment=DISABLE_AUTOUPDATER
ExecStart={{ claude_code_bin }} update
ExecStartPost={{ claude_prune_script }} --dir {{ claude_code_versions_dir }} --keep-target {{ claude_code_bin }} --keep {{ claude_code_keep_versions }}
ExecStartPost={{ claude_prune_script }} --dir {{ claude_code_desktop_bundled_dir }} --keep {{ claude_code_keep_versions }}
Nice=10
