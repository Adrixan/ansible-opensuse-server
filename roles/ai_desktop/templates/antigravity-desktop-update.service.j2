# {{ ansible_managed }}
[Unit]
Description=Update Antigravity Desktop from Google's release repository
Wants=network-online.target
After=network-online.target
# A laptop's catch-up run right after a wake may come before the network: retry a few times
StartLimitIntervalSec=1h
StartLimitBurst=4

[Service]
Type=oneshot
Restart=on-failure
RestartSec=5min
ExecStart=/usr/local/sbin/antigravity-desktop-update --releases-url {{ antigravity_desktop_releases_url }} --bucket-url {{ antigravity_desktop_bucket_url }} --metadata-url {{ antigravity_desktop_metadata_url }} --install-root {{ antigravity_desktop_install_root }} --install-dir {{ antigravity_desktop_install_dir }} --version {{ antigravity_desktop_version }} --keep {{ antigravity_desktop_keep_versions }}
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths={{ antigravity_desktop_install_root }}
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
