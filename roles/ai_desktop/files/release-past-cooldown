#!/usr/bin/env python3
"""Print the newest GitHub release tag (no draft, no pre-release), PyPI version or npm version published
before a cutoff. Usage: release-past-cooldown github <owner/repo> <hours>
                        release-past-cooldown pypi <package> <hours>
                        release-past-cooldown npm <package> <hours>
npm: the highest X.Y.Z version (no pre-release, not deprecated) at or below the `latest` dist-tag, so a
release that only reached `next` never qualifies."""
import json
import re
import sys
import time
import urllib.request
from datetime import datetime

kind, name, hours = sys.argv[1], sys.argv[2], float(sys.argv[3])
cut = time.time() - hours * 3600


def get(url: str) -> object:
    req = urllib.request.Request(url, headers={"User-Agent": "vps-nightly"})
    with urllib.request.urlopen(req, timeout=30) as r:
        return json.load(r)


def ts(value: str) -> float:
    return datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()


if kind == "github":
    rels = get(f"https://api.github.com/repos/{name}/releases?per_page=30")
    ok = [r for r in rels if not r["draft"] and not r["prerelease"] and ts(r["published_at"]) <= cut]
    if not ok:
        sys.exit(1)
    print(max(ok, key=lambda r: ts(r["published_at"]))["tag_name"])
elif kind == "pypi":
    data = get(f"https://pypi.org/pypi/{name}/json")
    best = None
    for version, files in data["releases"].items():
        good = [f for f in files if not f.get("yanked")]
        if not good or any(c.isalpha() and c not in "post" for c in version.split("+")[0]):
            continue  # skip pre-releases (a, b, rc, dev)
        uploaded = min(ts(f["upload_time_iso_8601"]) for f in good)
        if uploaded <= cut and (best is None or uploaded > best[1]):
            best = (version, uploaded)
    if best is None:
        sys.exit(1)
    print(best[0])
elif kind == "npm":
    data = get(f"https://registry.npmjs.org/{name}")
    versions = data.get("versions", {})

    def key(version: str) -> tuple[int, ...]:
        return tuple(int(part) for part in version.split("."))

    latest = data.get("dist-tags", {}).get("latest", "")
    ok = [
        v for v, published in data.get("time", {}).items()
        if re.fullmatch(r"\d+\.\d+\.\d+", v) and v in versions and not versions[v].get("deprecated")
        and re.fullmatch(r"\d+\.\d+\.\d+", latest) and key(v) <= key(latest) and ts(published) <= cut
    ]
    if not ok:
        sys.exit(1)
    print(max(ok, key=key))
else:
    sys.exit(2)
