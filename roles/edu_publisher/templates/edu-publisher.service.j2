# {{ ansible_managed }}
[Unit]
Description=Publish due Prof. Aufner posts (edu-publisher)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=PATH={{ edu_publisher_user_home }}/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart={{ edu_publisher_bin }} run
TimeoutStartSec={{ edu_publisher_timeout }}
Nice=10
StandardOutput=journal
StandardError=journal
