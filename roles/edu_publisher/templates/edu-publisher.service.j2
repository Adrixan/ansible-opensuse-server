# {{ ansible_managed }}
[Unit]
Description=Push approved Prof. Aufner pieces to the publishing server (edu-publisher sync)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=PATH={{ edu_publisher_user_home }}/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart={{ edu_publisher_bin }} sync
TimeoutStartSec={{ edu_publisher_timeout }}
Nice=10
StandardOutput=journal
StandardError=journal
